{
  "name": "pagelet-api",
  "version": "0.1.0",
  "private": true,
  "description": "Pagelet HTTP API for Azure Static Web Apps managed Functions (Node.js 22, programming model v4).",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "bundle": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude 'tests/**'"
  },
  "dependencies": {
    "@azure/functions": "4.17.1",
    "@azure/storage-blob": "12.34.0",
    "pg": "8.23.1",
    "stripe": "23.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
