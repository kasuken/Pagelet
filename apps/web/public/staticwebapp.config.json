{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/api/*",
      "/assets/*",
      "/fonts/*",
      "*.{css,js,map,png,jpg,jpeg,webp,svg,ico,woff2,txt,xml,json}"
    ]
  },
  "routes": [
    {
      "route": "/studio",
      "allowedRoles": [
        "authenticated"
      ],
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      }
    },
    {
      "route": "/studio/*",
      "allowedRoles": [
        "authenticated"
      ],
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      }
    },
    {
      "route": "/library",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      }
    },
    {
      "route": "/account/*",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      }
    },
    {
      "route": "/checkout/*",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      }
    },
    {
      "route": "/learn/*",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      }
    }
  ],
  "platform": {
    "apiRuntime": "node:22"
  },
  "globalHeaders": {
    "Content-Security-Policy": "default-src 'self'; img-src 'self' data: https://*.blob.core.windows.net; style-src 'self'; font-src 'self'; script-src 'self'; connect-src 'self' https://*.blob.core.windows.net; media-src 'self' blob: https://*.blob.core.windows.net; frame-ancestors 'none'; base-uri 'self';",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Permissions-Policy": "camera=(), microphone=(), geolocation=()"
  }
}
